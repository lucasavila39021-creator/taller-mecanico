# Copiar este archivo como .env y completar los valores vacíos.
# El archivo .env no se versiona.

# Base de datos
POSTGRES_USER=postgres
# Obligatoria: la contraseña de tu usuario de PostgreSQL.
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
# true muestra las consultas SQL en la consola.
SQL_ECHO=false

# Seguridad
# Obligatoria, mínimo 32 caracteres. Se genera con:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
BCRYPT_COST=12
# Cuántos cálculos de bcrypt corren a la vez.
BCRYPT_CONCURRENCIA=4
TOKEN_DURACION_SEGUNDOS=1800
# false para desarrollo local por http; true en producción con https.
COOKIE_SECURE=false
